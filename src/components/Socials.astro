---
import SocialIcon from './SocialIcon.astro';

interface Social {
    icon: 'github' | 'linkedIn' | 'email';
    link: string;
    title?: string;
}

const socials: Social[] = [{
    icon: 'github',
    link: 'https://github.com/lucas6RM',
    title: 'View GitHub Profile'
}, {
    icon: 'linkedIn',
    link: 'https://www.linkedin.com/in/lucas-mercier-95404056/',
    title: 'View LinkedIn Profile'
}, {
    icon: 'email',
    link: 'mailto:lucasmercier.dev@gmail.com',
    title: 'Send Email'
}];

---

<script>
    const emailButton = document.querySelector('[data-copy-email]');
    if (emailButton) {
        emailButton.addEventListener('click', () => {
            navigator.clipboard.writeText('lucasmercier.dev@gmail.com')
                .then(() => alert('Email copied to clipboard!'))
                .catch(() => alert('Failed to copy email'));
        });
    }
</script>

<!-- Start: Social Links -->
<div class="flex flex-wrap gap-3 mt-6 justify-between">

    {socials.map(social =>
        social.icon === 'email' ? (
                <button
                        data-copy-email
                        title={social.title}
                        class="flex items-center justify-center w-10 h-10 rounded-lg bg-black text-gray-100 hover:bg-purple-300">
                    <SocialIcon icon={social.icon} />
                </button>
        ) : (
                <a
                        href={social.link}
                        target="_blank"
                        rel="noopener noreferrer"
                        title={social.title}
                        class="flex items-center justify-center w-10 h-10 rounded-lg bg-black text-gray-100 hover:bg-purple-300">
                    <SocialIcon icon={social.icon} />
                </a>
        )
    )}


</div>
<!-- End: Social Links -->